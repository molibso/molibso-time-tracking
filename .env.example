# Local PostgreSQL (Docker Compose defaults — see docker-compose.yml)
# Start DB first: npm run db:up
DATABASE_URL="postgresql://molibso:molibso@localhost:5432/molibso?schema=public"
DIRECT_URL="postgresql://molibso:molibso@localhost:5432/molibso?schema=public"

AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Set false when using local Postgres (default for this project)
USE_MOCK_DATA=false

# Optional email (only needed if SMTP_HOST is set)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=molibso <no-reply@molibso.de>
